{
  "manifest_version": 3,
  "name": "FlowTask Quick Capture",
  "version": "1.0.0",
  "description": "One-click universal task capture into FlowTask from any webpage.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture Task to FlowTask"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.vercel.app/*",
        "*://*/*flowtask*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
