{
  "manifest_version": 3,
  "name": "FlowTask Quick Capture",
  "version": "1.1.0",
  "description": "One-click universal task capture into FlowTask from any webpage.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture Task to FlowTask"
  },
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
