# FlowTask Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Production origin for social links and API checks. Vercel Previews validate
# their own platform-injected VERCEL_URL instead of accepting request headers.
APP_ORIGIN=https://your-flowtask-domain.example
# Server-only Vercel credentials (never prefix these with VITE_)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Optional private ICS proxy deployed from workers/calendar-proxy.js
VITE_CALENDAR_PROXY_URL=

# Optional App Check; monitor valid traffic before enabling enforcement in Firebase.
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# Both deployment flag and explicit user opt-in are required for remote reports.
VITE_DIAGNOSTICS_ENABLED=false
DIAGNOSTICS_ENABLED=false
