rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && (!exists(/databases/$(database)/documents/users/$(uid))
          || get(/databases/$(database)/documents/users/$(uid)).data.get('deletionPending', false) == false);
    }
    function revision() {
      return request.resource.data.revision is int && request.resource.data.revision >= 1
        && request.resource.data.updatedAt is number
        && request.resource.data.revision == (request.method == 'create' ? 1 : resource.data.get('revision', 0) + 1);
    }
    function validWidget(w) {
      // Enforce the renderable shape here; bounded optional metadata is normalized
      // on import/receive. Repeated per-field checks exceed the 24-widget rule budget.
      return w.id is string
        && w.type.matches('^(top3|taskList|dayAgenda|capacityProgress|focusLaunchpad|projects|studyContinuation|quickNotes|weeklyWorkload|recentActivity|resources|quietScene)$')
        && w.config is map;
    }
    function validNoteVersion(v) {
      return v is map && v.keys().hasOnly(['id','title','body','savedAt'])
        && v.id is string && v.id.size() <= 200
        && v.title is string && v.title.size() <= 200
        && v.body is string && v.body.size() <= 40000
        && v.savedAt is number && v.savedAt >= 0;
    }
    function validNote() {
      let n = request.resource.data;
      let count = n.versions.size();
      return n.keys().hasOnly(['id','title','body','formatVersion','createdAt','updatedAt','revision','projectId','dailyDate','tags','favorite','archivedAt','deletedAt','versions','linkedTasks','relatedNoteIds','importedFrom'])
        && n.title is string && n.title.size() > 0 && n.title.size() <= 200
        && n.body is string && n.body.size() <= 40000 && n.formatVersion == 1
        && n.createdAt is number && n.createdAt >= 0 && n.updatedAt >= 0
        && n.favorite is bool && n.tags is list && n.tags.size() <= 20
        && n.linkedTasks is list && n.linkedTasks.size() <= 30
        && (!('relatedNoteIds' in n) || (n.relatedNoteIds is list && n.relatedNoteIds.size() <= 200))
        && n.versions is list && count <= 4
        && (count < 1 || validNoteVersion(n.versions[0]))
        && (count < 2 || validNoteVersion(n.versions[1]))
        && (count < 3 || validNoteVersion(n.versions[2]))
        && (count < 4 || validNoteVersion(n.versions[3]))
        && (!('projectId' in n) || (n.projectId is string && n.projectId.size() <= 200))
        && (!('dailyDate' in n) || (n.dailyDate is string && n.dailyDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('deletedAt' in n) || (n.deletedAt is number && n.deletedAt >= 0))
        && (!('archivedAt' in n) || (n.archivedAt is number && n.archivedAt >= 0))
        && (!('importedFrom' in n) || n.importedFrom == 'scratchpad');
    }
    function validDashboard() {
      let d = request.resource.data;
      let widgets = d.widgets;
      let count = widgets.size();
      return d.keys().hasOnly(['id','name','icon','coverImage','coverFocalPoint','isDefault','order','widgets','layouts','revision','createdAt','updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.order is int && d.order >= 0 && d.order <= 100
        && d.createdAt is number && d.widgets is list && d.widgets.size() <= 24
        && (!('coverFocalPoint' in d) || (d.coverFocalPoint is map && d.coverFocalPoint.keys().hasOnly(['x','y'])
          && d.coverFocalPoint.x is number && d.coverFocalPoint.x >= 0 && d.coverFocalPoint.x <= 100
          && d.coverFocalPoint.y is number && d.coverFocalPoint.y >= 0 && d.coverFocalPoint.y <= 100))
        && d.layouts is map && d.layouts.keys().hasOnly(['lg','md'])
        && d.layouts.lg is list && d.layouts.lg.size() <= 24
        && (!('md' in d.layouts) || (d.layouts.md is list && d.layouts.md.size() <= 24))
        && (count <= 0 || validWidget(widgets[0]))
        && (count <= 1 || validWidget(widgets[1]))
        && (count <= 2 || validWidget(widgets[2]))
        && (count <= 3 || validWidget(widgets[3]))
        && (count <= 4 || validWidget(widgets[4]))
        && (count <= 5 || validWidget(widgets[5]))
        && (count <= 6 || validWidget(widgets[6]))
        && (count <= 7 || validWidget(widgets[7]))
        && (count <= 8 || validWidget(widgets[8]))
        && (count <= 9 || validWidget(widgets[9]))
        && (count <= 10 || validWidget(widgets[10]))
        && (count <= 11 || validWidget(widgets[11]))
        && (count <= 12 || validWidget(widgets[12]))
        && (count <= 13 || validWidget(widgets[13]))
        && (count <= 14 || validWidget(widgets[14]))
        && (count <= 15 || validWidget(widgets[15]))
        && (count <= 16 || validWidget(widgets[16]))
        && (count <= 17 || validWidget(widgets[17]))
        && (count <= 18 || validWidget(widgets[18]))
        && (count <= 19 || validWidget(widgets[19]))
        && (count <= 20 || validWidget(widgets[20]))
        && (count <= 21 || validWidget(widgets[21]))
        && (count <= 22 || validWidget(widgets[22]))
        && (count <= 23 || validWidget(widgets[23]));
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow write: if false;
      match /tasks/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && revision() && request.resource.data.id == id
          && request.resource.data.keys().hasOnly(['reminders','workBlocks','originNoteId','milestoneId','scheduleLocked','nextAction','recurrenceSourceId','id','title','description','status','priority','projectId','plannedDate','dueDate','dueTime','topThreeDate','isPinnedToday','isSomeday','isEvening','archivedAt','deletedAt','revision','updatedAt','estimatedMinutes','timeSpentMinutes','subtasks','recurrence','customRecurrence','scheduledStart','scheduledEnd','timezone','tags','contextTags','blockedBy','sessionMetadata','rolloverCount','lastRolledOverAt','bufferMinutes','isAutoTriaged','createdAt','completedAt','deferUntil','areaId','goalId','cognitiveLoad','isLifeAdmin','cleanSlateQuarantinedAt','predecessorTaskId'])
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 10000
          && request.resource.data.status in ['todo','in_progress','done'] && request.resource.data.priority in ['p1','p2','p3','p4']
          && request.resource.data.projectId is string && request.resource.data.subtasks is list && request.resource.data.subtasks.size() <= 1000
          && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 100000))
          && (!('originNoteId' in request.resource.data) || (request.resource.data.originNoteId is string && request.resource.data.originNoteId.size() <= 200))
          && (!('blockedBy' in request.resource.data) || (request.resource.data.blockedBy is list && request.resource.data.blockedBy.size() <= 1000))
          && (!('reminders' in request.resource.data) || (request.resource.data.reminders is list && request.resource.data.reminders.size() <= 50))
          && (!('workBlocks' in request.resource.data) || (request.resource.data.workBlocks is list && request.resource.data.workBlocks.size() <= 100))
          && (!('deferUntil' in request.resource.data) || (request.resource.data.deferUntil is string && request.resource.data.deferUntil.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && (!('areaId' in request.resource.data) || (request.resource.data.areaId is string && request.resource.data.areaId.size() <= 200))
          && (!('goalId' in request.resource.data) || (request.resource.data.goalId is string && request.resource.data.goalId.size() <= 200))
          && (!('cognitiveLoad' in request.resource.data) || request.resource.data.cognitiveLoad in ['deep_work','medium','shallow'])
          && (!('isLifeAdmin' in request.resource.data) || request.resource.data.isLifeAdmin is bool)
          && (!('cleanSlateQuarantinedAt' in request.resource.data) || (request.resource.data.cleanSlateQuarantinedAt is number && request.resource.data.cleanSlateQuarantinedAt >= 0))
          && (!('predecessorTaskId' in request.resource.data) || (request.resource.data.predecessorTaskId is string && request.resource.data.predecessorTaskId.size() <= 200));
      }
      match /projects/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && revision() && request.resource.data.id == id
          && request.resource.data.keys().hasOnly(['areaId','milestones','outcome','targetDate','coverAssetId','coverFocalPoint','focusRecipeId','wipLimit','revision','id','name','color','icon','isArchived','archivedAt','createdAt','updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
          && request.resource.data.color is string
          && (!('areaId' in request.resource.data) || (request.resource.data.areaId is string && request.resource.data.areaId.size() <= 200))
          && (!('milestones' in request.resource.data) || (request.resource.data.milestones is list && request.resource.data.milestones.size() <= 100));
      }
      match /notes/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && revision() && request.resource.data.id == id && validNote();
      }
      match /dashboards/{id} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) && revision() && request.resource.data.revision == 1 && request.resource.data.id == id && validDashboard();
        allow update: if owner(uid) && revision() && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.id == id && validDashboard();
      }
      match /focusLogs/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && revision() && request.resource.data.id == id
          && request.resource.data.seconds is number && request.resource.data.seconds >= 0
          && request.resource.data.mode in ['pomodoro','countdown','stopwatch','sprint']
          && request.resource.data.startedAt is number && request.resource.data.endedAt is number
          && (!('phase' in request.resource.data) || request.resource.data.phase in ['focus','short_break','long_break']);
      }
      match /recipes/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && revision() && request.resource.data.id == id
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && request.resource.data.sceneId is string && request.resource.data.layers is list
          && request.resource.data.layers.size() <= 4 && request.resource.data.timer is map;
      }
      match /preferences/{id} {
        allow read, delete: if owner(uid) && id in ['settings','appearance','studio','templates','customViews','profile','workspace'];
        allow create, update: if owner(uid) && revision() && request.resource.data.id == id
          && id in ['settings','appearance','studio','templates','customViews','profile','workspace']
          && request.resource.data.keys().hasOnly(['id','value','revision','updatedAt']);
      }
      match /operations/{id} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) && request.resource.data.keys().hasOnly(['createdAt','description','expiresAt'])
          && request.resource.data.createdAt is number && request.resource.data.description is string && request.resource.data.description.size() <= 1000
          && (!('expiresAt' in request.resource.data) || request.resource.data.expiresAt is timestamp);
        allow update: if false;
      }
      match /areas/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && revision() && request.resource.data.id == id
          && request.resource.data.keys().hasOnly(['id','name','description','color','icon','sortOrder','archivedAt','revision','createdAt','updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
          && request.resource.data.sortOrder is int && request.resource.data.sortOrder >= 0;
      }
      match /goals/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && revision() && request.resource.data.id == id
          && request.resource.data.keys().hasOnly(['id','title','description','targetQuarter','targetDate','areaId','projectIds','status','progressMode','manualProgress','successCriteria','archivedAt','revision','createdAt','updatedAt'])
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
          && request.resource.data.status in ['not_started','in_progress','paused','achieved','active','deferred']
          && request.resource.data.projectIds is list && request.resource.data.projectIds.size() <= 50;
      }
      match /routines/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && revision() && request.resource.data.id == id
          && request.resource.data.keys().hasOnly(['id','title','cadence','steps','archivedAt','revision','createdAt','updatedAt'])
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
          && request.resource.data.cadence in ['morning','evening','workday_start','weekly']
          && request.resource.data.steps is list && request.resource.data.steps.size() <= 50;
      }
      match /routineRuns/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && revision() && request.resource.data.id == id
          && request.resource.data.keys().hasOnly(['id','routineId','startedAt','completedAt','completedStepsCount','totalStepsCount','totalDurationSeconds','revision','createdAt','updatedAt'])
          && request.resource.data.routineId is string && request.resource.data.startedAt is number && request.resource.data.completedAt is number;
      }
      match /workBlocks/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && revision() && request.resource.data.id == id
          && request.resource.data.keys().hasOnly(['id','taskId','startInstant','endInstant','timezone','status','date','startTime','endTime','durationMinutes','title','isLocked','completedAt','externalEventId','revision','createdAt','updatedAt'])
          && request.resource.data.taskId is string && request.resource.data.startInstant is number && request.resource.data.endInstant is number
          && request.resource.data.status in ['scheduled','in_progress','completed','cancelled'];
      }
      match /reviews/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && revision() && request.resource.data.id == id
          && request.resource.data.keys().hasOnly(['id','periodStart','periodEnd','reviewedAt','reflection','nextPriorities','completedTasksCount','totalEstimatedMinutes','totalFocusSeconds','revision','createdAt','updatedAt'])
          && request.resource.data.periodStart is string && request.resource.data.periodEnd is string && request.resource.data.reviewedAt is number;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
