{
  "name": "flowtask",
  "private": true,
  "version": "2.0.0-beta.1",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "preview": "vite preview",
    "test:security": "node --test scripts/security.test.mjs scripts/production-security.test.mjs",
    "test:rules": "node scripts/test-rules.mjs",
    "typecheck": "tsc -b --pretty false",
    "test:rules:connected": "node --test scripts/firestore-rules.test.mjs",
    "test:budgets": "node scripts/check-budgets.mjs",
    "test:performance": "node scripts/check-lab-performance.mjs",
    "test:e2e:release": "playwright test --config=playwright.release.config.ts",
    "test:cloud:staging": "node scripts/test-staging-cloud.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "chrono-node": "^2.10.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^14.0.0",
    "ical.js": "^2.2.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^2.3.0",
    "tailwind-merge": "^3.7.0",
    "web-vitals": "^5.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "firebase-admin": {
      "jwks-rsa": "3.2.2"
    }
  }
}
